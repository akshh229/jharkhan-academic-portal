  // --- HELPER FUNCTIONS ---
  const getStudentFullName = (studentId) => { const s = students.find(s => s.student_id === studentId); return s ? `${s.first_name} ${s.last_name}` : 'Unknown'; };
  const getSubjectName = (subjectId) => { const s = subjects.find(s => s.subject_id === subjectId); return s ? s.subject_name : 'Unknown'; };
  const getExamName = (examId) => { const e = exams.find(e => e.exam_id === examId); return e ? e.exam_name : 'Unknown'; };
  const getClassName = (classId) => { const c = classes.find(cls => cls.class_id === classId); return c ? c.class_name : 'Unknown'; };
  
  // Premium Attendance Helper Functions
  const getAttendanceStats = (classId = null, date = null) => {
    let data = attendanceData;
    if (classId) data = data.filter(a => a.class_id === classId);
    if (date) data = data.filter(a => a.attendance_date === date);
    
    const total = data.length;
    const present = data.filter(a => a.status === 'Present').length;
    const late = data.filter(a => a.status === 'Late').length;
    const absent = data.filter(a => a.status === 'Absent').length;
    
    return {
      total,
      present,
      late,
      absent,
      presentRate: total > 0 ? ((present + late) / total * 100).toFixed(1) : 0,
      onTimeRate: total > 0 ? (present / total * 100).toFixed(1) : 0
    };
  };
  
  const getFilteredAttendance = () => {
    let filtered = attendanceData.filter(a => a.attendance_date === attendanceFilters.date);
    
    if (attendanceFilters.class_id) {
      filtered = filtered.filter(a => a.class_id === parseInt(attendanceFilters.class_id));
    }
    if (attendanceFilters.subject) {
      filtered = filtered.filter(a => a.subject.toLowerCase().includes(attendanceFilters.subject.toLowerCase()));
    }
    if (attendanceFilters.status) {
      filtered = filtered.filter(a => a.status === attendanceFilters.status);
    }
    if (attendanceFilters.search) {
      const searchLower = attendanceFilters.search.toLowerCase();
      filtered = filtered.filter(a => {
        const student = students.find(s => s.student_id === a.student_id);
        const studentName = student ? `${student.first_name} ${student.last_name}`.toLowerCase() : '';
        return studentName.includes(searchLower) || a.subject.toLowerCase().includes(searchLower);
      });
    }
    
    return filtered;
  };
  
  const handleAttendanceToggle = (attendanceId) => {
    setSelectedAttendance(prev => 
      prev.includes(attendanceId) 
        ? prev.filter(id => id !== attendanceId)
        : [...prev, attendanceId]
    );
  };
  
  const handleBulkAttendanceAction = () => {
