  const generateAttendanceData = () => {
    const dates = ['2025-09-16', '2025-09-17', '2025-09-18', '2025-09-19', '2025-09-20', '2025-09-21'];
    const timeSlots = ['09:00', '10:00', '11:00', '12:00', '14:00', '15:00', '16:00'];
    const subjects = ['Mathematics', 'Science', 'English', 'Hindi', 'Social Science', 'Computer Science', 'Physical Education'];
    let attendanceId = 1;
    const data = [];
    
    dates.forEach(date => {
      students.forEach(student => {
        timeSlots.forEach((time, idx) => {
          const isPresent = Math.random() > 0.15; // 85% attendance rate
          const isLate = isPresent && Math.random() > 0.9; // 10% late when present
          data.push({
            attendance_id: attendanceId++,
            student_id: student.student_id,
            class_id: student.class_id,
            attendance_date: date,
            time_slot: time,
            subject: subjects[idx],
            status: !isPresent ? 'Absent' : isLate ? 'Late' : 'Present',
            check_in_time: isPresent ? (isLate ? `${time}:${Math.floor(Math.random() * 20) + 10}` : `${time}:0${Math.floor(Math.random() * 10)}`) : null,
            remarks: !isPresent ? (Math.random() > 0.7 ? 'Medical' : Math.random() > 0.5 ? 'Personal' : '') : ''
          });
        });
      });
    });
    return data;
  };
  
