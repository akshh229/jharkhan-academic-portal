  const augmentBaseResults = (input) => {
    const usedIds = new Set(input.map(r => r.result_id));
    let nextId = Math.max(...Array.from(usedIds)) + 1;
    const coreSubjects = [1,2,3,4,5];
    const studentIdsToAugment = students.slice(0, 30).map(s => s.student_id);
    const byStudentExam = new Map();
    input.forEach(r => {
      const key = `${r.student_id}|${r.exam_id}`;
      const set = byStudentExam.get(key) || new Set();
      set.add(r.subject_id);
      byStudentExam.set(key, set);
    });
    const extra = [];
    studentIdsToAugment.forEach(sid => {
      const key = `${sid}|2`;
      const have = byStudentExam.get(key) || new Set();
      coreSubjects.forEach(sub => {
        if (!have.has(sub)) {
          extra.push({
            result_id: nextId++, student_id: sid, exam_id: 2, subject_id: sub,
            marks_obtained: Math.floor(60 + Math.random()*35), total_marks: 100.00
          });
        }
      });
    });
    return [...input, ...extra];
  };

